{
  "name": "techfeatures-chatbot-automation",
  "version": "1.0.0",
  "description": "Automated Chatbot Testing & Evaluation Suite with Cypress & Groq AI Judge",
  "scripts": {
    "test:api": "python run_automation.py --pilot",
    "test:api:all": "python run_automation.py",
    "test:api:id": "python run_automation.py --test-id",
    "cypress:open": "cypress open",
    "cypress:ui": "cypress run --headed --no-exit --spec 'cypress/e2e/chatbot_frontend_ui.cy.js'",
    "cypress:headed": "cypress run --headed --spec 'cypress/e2e/chatbot_frontend_ui.cy.js'",
    "cypress:excel": "cypress run --headed --no-exit --spec 'cypress/e2e/chatbot_excel_scenarios.cy.js'"
  },
  "devDependencies": {
    "cypress": "^14.1.0",
    "dotenv": "^16.4.7",
    "groq-sdk": "^0.15.0",
    "xlsx": "^0.18.5"
  }
}
